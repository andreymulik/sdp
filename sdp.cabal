name:          sdp
version:       0.3
category:      Data Structures

synopsis:      Simple Data Processing
description:   SDP provides generalized interface for simple data operations.

author:        Andrey Mulik
maintainer:    work.a.mulik@gmail.com
bug-reports:   https://github.com/andreymulik/sdp/issues

copyright:     2019-2025 Andrey Mulik
license-file:  LICENSE
license:       BSD3

build-type:    Simple
cabal-version: >=1.10

tested-with:
  -- lts-7.0
  GHC == 8.0.1,
  -- lts-7.24
  GHC == 8.0.1,
  -- lts-9.21
  GHC == 8.0.2,
  -- lts-11.22
  GHC == 8.2.2,
  -- lts-12.26
  GHC == 8.4.4,
  -- lts-14.27
  GHC == 8.6.5,
  -- lts-18.8
  GHC == 8.10.6,
  -- lts-18.24
  GHC == 8.10.7,
  -- lts-19.21
  GHC == 9.0.2,
  -- nightly-2022-09-04
  GHC == 9.2.4

source-repository head
  type: git
  location: https://github.com/andreymulik/sdp

---            _      _____ ______ ______   ___  ______ __   __              ---
---           | |    |_   _|| ___ \| ___ \ / _ \ | ___ \\ \ / /              ---
---           | |      | |  | |_/ /| |_/ // /_\ \| |_/ / \ V /               ---
---           | |      | |  | ___ \|    / |  _  ||    /   \ /                ---
---           | |____ _| |_ | |_/ /| |\ \ | | | || |\ \   | |                ---
---           \_____/ \___/ \____/ \_| \_|\_| |_/\_| \_|  \_/                ---


Library
  default-language: Haskell2010
  hs-source-dirs:   src
  
  build-tools: cpphs >=1.19
  ghc-options: -O2 -Wall -Wcompat -Wall-missed-specialisations
               -pgmPcpphs -optP--cpp -optP-traditional
  
  build-depends:
    base     >= 4.9 && <    5,
    sdp-core >= 0.3 && <  0.4,
    ghc-prim >= 0.5 && < 0.14
  
  -- GHC 8.2.2 bug
  if impl(ghc >= 8.4)
    cpp-options: -DSDP_LINEAR_EXTRAS
  
  if impl(ghc >= 8.6)
    cpp-options: -DSDP_QUALIFIED_CONSTRAINTS
  
  -- GHC 8.0.2 bug
  if impl(ghc == 8.0.2)
    cpp-options: -DSDP_DISABLE_SHAPED
  
  exposed-modules:
    SDP.Templates.AnyBorder
    
    SDP.Prim.SArray.IO
    SDP.Prim.SArray.ST
    SDP.Prim.SArray
    
    SDP.Prim.SBytes.IO
    SDP.Prim.SBytes.ST
    SDP.Prim.SBytes
    
    SDP.Array.IO
    SDP.Array.ST
    SDP.Array
    
    SDP.Bytes.IO
    SDP.Bytes.ST
    SDP.Bytes

